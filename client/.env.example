# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Production only: the API's public URL. Leave empty locally (Vite proxies /api).
VITE_API_URL=

# The public website, for the "Back to the homepage" link on the login page.
# Leave empty in production (the app runs on mentorbridge.nl). Locally: http://localhost:5174
VITE_LANDING_URL=
