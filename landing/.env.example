# Where the Node API runs. In production, the API's public URL.
VITE_API_URL=http://localhost:4000

# Optional: Google Tag Manager container ID (GTM-XXXXXXX). Shows a cookie consent bar.
VITE_GTM_ID=

# Optional: platform app address for the "Log in" button. Defaults to the live app.
VITE_APP_URL=

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX), loaded after cookie consent.
VITE_GA_ID=
